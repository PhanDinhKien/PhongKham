# Copy file này thành .env rồi điền giá trị thật. File .env KHÔNG được đẩy lên Git.

# ===== SQL Server (docker-compose.yml + application.yaml) =====
# Mật khẩu sa phải >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=
DB_NAME=SaleDB

# ===== Tài khoản admin tạo sẵn khi khởi động (AdminSeeder) =====
ADMIN_SEED_ENABLED=true
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@phongkham.local
ADMIN_PASSWORD=
